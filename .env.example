# ==============================================
# Fin-Agent Environment Configuration
# ==============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# Database Configuration
POSTGRES_USER=user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=fin_agent

# AI API Keys (at least one required for research features)
GENAI_API_KEY=your_google_gemini_api_key
GPT_API_SECRET=your_openai_api_key

# Frontend Configuration (optional - defaults to relative paths for nginx proxy)
# Only set if you need to override the API URL
# NEXT_PUBLIC_API_BASE_URL=http://your-ec2-public-ip/api
