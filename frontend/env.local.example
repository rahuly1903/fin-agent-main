# -----------------------------------------------------------------------------
# Frontend env (Next.js)
# Copy this file to `frontend/.env.local` (locally) and fill in values.
# -----------------------------------------------------------------------------

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Default number of rows requested/displayed in the "Top Picks" table
NEXT_PUBLIC_TOP_IRR_LIMIT=25

# Retry transient network failures when waiting for long-running /api/top-irr (dev-friendly)
NEXT_PUBLIC_TOP_IRR_MAX_RETRIES=3


