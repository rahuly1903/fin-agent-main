# -----------------------------------------------------------------------------
# Frontend env (Next.js) - Production (EC2)
# API calls use relative paths proxied by nginx — no NEXT_PUBLIC_API_BASE_URL needed
# -----------------------------------------------------------------------------

# Leave blank to use relative paths via nginx (recommended for production)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Default number of rows requested/displayed in the "Top Picks" table
NEXT_PUBLIC_TOP_IRR_LIMIT=25

# Retry transient network failures when waiting for long-running /api/top-irr
NEXT_PUBLIC_TOP_IRR_MAX_RETRIES=3
